<Project>
  <PropertyGroup>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\Fences.snk</AssemblyOriginatorKeyFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);S8969;S8970</NoWarn>
    <NuGetAuditMode>direct</NuGetAuditMode>
    <SignAssembly>true</SignAssembly>
    <FencesStrongNamePublicKey Condition=" '$(SignAssembly)' == 'true' "></FencesStrongNamePublicKey>
  </PropertyGroup>

  <ItemGroup Condition="'$(LegacySupport)' == 'true' AND !$([MSBuild]::IsTargetFrameworkCompatible($(TargetFramework), 'netcoreapp3.1'))">
    <Compile Include="$(MSBuildThisFileDirectory)..\src\LegacySupport\*.cs" LinkBase="LegacySupport" />
  </ItemGroup>

  <ItemGroup Label="MinVer">
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>

  <PropertyGroup Label="MinVer">
    <MinVerMinimumMajorMinor>8.7</MinVerMinimumMajorMinor>
  </PropertyGroup>

</Project>
