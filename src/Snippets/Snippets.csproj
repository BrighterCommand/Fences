<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnablePackageValidation>false</EnablePackageValidation>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <NoWarn>$(NoWarn);CA1031;CA1062;CA1064;CA1303;CA1848;CA2000;CA2007</NoWarn>
    <NoWarn>$(NoWarn);CS1998</NoWarn>
    <NoWarn>$(NoWarn);IDE0017;IDE0021;IDE0022;IDE0028;IDE0060</NoWarn>
    <NoWarn>$(NoWarn);RS0016;RS0037</NoWarn>
    <NoWarn>$(NoWarn);S3257</NoWarn>
    <NoWarn>$(NoWarn);SA1123;SA1204;SA1402;SA1515;SA1600</NoWarn>
    <Nullable>enable</Nullable>
    <ProjectType>Library</ProjectType>
    <RootNamespace>Snippets</RootNamespace>
    <SignAssembly>false</SignAssembly>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paramore.Fences.Extensions\Paramore.Fences.Extensions.csproj" />
    <ProjectReference Include="..\Paramore.Fences.RateLimiting\Paramore.Fences.RateLimiting.csproj" />
    <ProjectReference Include="..\Paramore.Fences.Testing\Paramore.Fences.Testing.csproj" />
    <ProjectReference Include="..\Paramore.Fences\Paramore.Fences.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Flurl.Http.Signed" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="RestSharp" />
    <PackageReference Include="xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!--
      Polly is a direct dependency here on purpose: Microsoft.Extensions.Http.Resilience
      is built on Polly, so the HttpClient snippets demonstrate Fences and Polly
      side by side. There is deliberately no `<Using Include="Paramore.Fences" />`
      - both libraries export types with the same names, so each file imports the
      one it means.
    -->
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

</Project>
