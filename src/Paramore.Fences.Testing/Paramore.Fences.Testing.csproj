<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <AssemblyTitle>Paramore.Fences.Testing</AssemblyTitle>
    <RootNamespace>Paramore.Fences.Testing</RootNamespace>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ProjectType>Library</ProjectType>
    <MutationScore>100</MutationScore>
  </PropertyGroup>

  <PropertyGroup>
    <Description>Paramore.Fences.Testing exposes APIs and utilities that can be used to assert on the composition of Paramore.Fences.Core resilience pipelines.</Description>
    <PackageTags>Paramore.Fences Exception Handling Resilience Transient Fault Policy Testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paramore.Fences.Core\Paramore.Fences.Core.csproj" />
  </ItemGroup>

</Project>
